# mSupply Dashboard customisations to Grafana core, for Grafana v13.2.2.
#
# Apply with `git apply changes.patch` from the root of a Grafana checkout at
# tag v13.2.2, after copying modifications/public over public/.
#
# Only the logo swap still needs a patch. Three hunks that used to live here
# were dropped on the move to v13:
#
#   * public/sass/base/_icons.scss    - the .gicon-branding rule no longer
#                                       exists in v13.
#   * public/views/index-template.html - renamed to index.html; the loading
#                                       logo now comes from [[.LoadingLogo]],
#                                       which resolves to public/img and so
#                                       needs no patch.
#   * packages/grafana-ui/.../DateTimePickers/options.ts - dropped. This used
#                                       to delete the sub-hour quick ranges;
#                                       we now ship Grafana's stock time
#                                       picker. quickOptions also became the
#                                       i18n'd getQuickOptions(), so the old
#                                       hunk could not apply anyway. If the
#                                       sub-hour ranges need trimming again,
#                                       use `[time_picker] quick_ranges` in
#                                       conf/custom.ini rather than a patch.
#
diff --git a/public/app/core/components/Branding/Branding.tsx b/public/app/core/components/Branding/Branding.tsx
index 42000d1..2df1389 100644
--- a/public/app/core/components/Branding/Branding.tsx
+++ b/public/app/core/components/Branding/Branding.tsx
@@ -7,7 +7,8 @@ import { reportInteraction } from '@grafana/runtime';
