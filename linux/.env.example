# mSupply Dashboard settings for this server. Copy to .env, fill in, then: chmod 600 .env
# Values in <...> must be replaced. Lines starting with # are notes and are ignored.

# --- Version --------------------------------------------------------------------------------
# Image and version to run. To update, change DASHBOARD_VERSION and run: docker compose up -d
DASHBOARD_IMAGE=msupplyfoundation/msupply-dashboard
DASHBOARD_VERSION=13.2.2

# --- This server ------------------------------------------------------------------------------
# Port users open in the browser.
GRAFANA_PORT=3000
# Address users type, exactly as they type it, with the port and a / at the end.
# Examples: http://10.0.0.5:3000/   https://dashboard.example.org:3000/
GF_SERVER_ROOT_URL=http://<server-address>:3000/
# Result of `id -u` for the Linux user that owns this folder.
GRAFANA_UID=1000
# Docker network for the dashboard. Keep it unless the range is already used on this network.
# pg_hba.conf must allow it.
DOCKER_SUBNET=172.30.0.0/24

# --- Dashboard database (PostgreSQL) --------------------------------------------------------------
# The database the mSupply server exports into. host.docker.internal = this server.
PG_HOST=host.docker.internal
PG_PORT=5432
PG_DATABASE=dashboard
PG_USER=dashboard
PG_PASSWORD=<database password>

# --- Grafana admin ------------------------------------------------------------------------------
# Set on every start. Use the team's standard password.
GF_SECURITY_ADMIN_PASSWORD=<admin password>

# --- Login through mSupply (OAuth) ----------------------------------------------------------------
# true to show the mSupply login button. MSUPPLY_SERVER_URL is the mSupply server address with its
# port (usually 2048), no / at the end. The login, token, user and logout URLs are built from it.
GF_AUTH_GENERIC_OAUTH_ENABLED=false
MSUPPLY_SERVER_URL=https://<msupply-server>:2048
GF_AUTH_GENERIC_OAUTH_CLIENT_ID=<client id>
GF_AUTH_GENERIC_OAUTH_CLIENT_SECRET=<client secret>

# --- Text panels ----------------------------------------------------------------------------------
# true lets text panels show HTML as written. Copy the value from the client's custom.ini
# ([panels] disable_sanitize_html) when moving a client from Windows.
GF_PANELS_DISABLE_SANITIZE_HTML=false

# --- Optional -------------------------------------------------------------------------------------
# Remove the # to use a setting.
#
# HTTPS served by Grafana itself. Put the files in ./certs and use https in GF_SERVER_ROOT_URL.
# GF_SERVER_PROTOCOL=https
# GF_SERVER_CERT_FILE=/certs/cert.pem
# GF_SERVER_CERT_KEY=/certs/key.pem
#
# Encryption key for data source passwords. Only when the client's custom.ini sets
# [security] secret_key: copy that value here, or the existing data source passwords will not work.
# GF_SECURITY_SECRET_KEY=
#
# Any other custom.ini setting: GF_<SECTION>_<KEY>=<value>, in capitals, dots and dashes as _.
# Example: [auth] oauth_auto_login = true  ->  GF_AUTH_OAUTH_AUTO_LOGIN=true
